#include <stdio.h>

int main() {
    int n, i;
    int fib[50];
    long long sum = 0;
    printf("Enter number of terms (1-50): ");
    if (scanf("%d", &n) != 1) {
        printf("Invalid input!\n");
        return 1;
    }
    if (n < 1 || n > 50) {
        printf("Invalid input! Please enter terms between 1 and 50.\n");
        return 0;
    }
    if (n >= 1) {
        fib[0] = 0;
    }
    if (n >= 2) {
        fib[1] = 1;
    }
    for (i = 2; i < n; i++) {
        fib[i] = fib[i - 1] + fib[i - 2];
    }
    for (i = 0; i < n; i++) {
        printf("%d ", fib[i]);
        sum += fib[i];
        if (i == 0) {
            largest = fib[i];
        } else if (fib[i] > largest) {
            largest = fib[i];
        }
    }
    printf("\n");
    printf("Sum of series: %lld\n", sum);
    printf("Largest term: %d\n", largest);

    return 0;
}

