#include <stdio.h>

int main() {
    int a[] = {10, 9, 7, 4, 3, 1, 2};
    int n = sizeof(a) / sizeof(a[0]);
    int max = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] > max) {
            max = a[i];
        }
    }
    printf("Missing elements: ");
    for (int i = 1; i <= max; i++) {
        int found = 0;
        for (int j = 0; j < n; j++) {
            if (a[j] == i) {
                found = 1;
                break;
            }
        }
        if (!found) {
            printf("%d ", i);
        }
    }
    printf("\n");

    return 0;
}
