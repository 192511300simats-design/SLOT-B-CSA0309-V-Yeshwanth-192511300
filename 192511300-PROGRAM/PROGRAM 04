#include <stdio.h>

#define MAX 100

typedef struct {
    int row, col, value;
} Triple;

void displayDense(Triple a[], int terms, int rows, int cols) {
    int k = 0;
    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
            if (k < terms && a[k].row == i && a[k].col == j) {
                printf("%d ", a[k].value);
                k++;
            } else {
                printf("0 ");
            }
        }
        printf("\n");
    }
}

int main() {
    Triple A[MAX], B[MAX], C[MAX];
    int r1, c1, t1, r2, c2, t2;
    int i, j, k;

    // Read Matrix 1
    if (scanf("%d%d%d", &r1, &c1, &t1) != 3) return 0;
    for (i = 0; i < t1; i++) {
        scanf("%d%d%d", &A[i].row, &A[i].col, &A[i].value);
    }

    // Read Matrix 2
    if (scanf("%d%d%d", &r2, &c2, &t2) != 3) return 0;
    for (i = 0; i < t2; i++) {
        scanf("%d%d%d", &B[i].row, &B[i].col, &B[i].value);
    }

    // Check if addition is possible
    if (r1 != r2 || c1 != c2) {
        printf("Matrix addition not possible.\n");
        return 0;
    }

    // Addition Logic
    i = 0; // Pointer for A
    j = 0; // Pointer for B
    k = 0; // Pointer for C

    while (i < t1 && j < t2) {
        if (A[i].row < B[j].row || (A[i].row == B[j].row && A[i].col < B[j].col)) {
            C[k++] = A[i++];
        } else if (B[j].row < A[i].row || (B[j].row == A[i].row && B[j].col < A[i].col)) {
            C[k++] = B[j++];
        } else {
            // Same position
            int sum = A[i].value + B[j].value;
            if (sum != 0) {
                C[k].row = A[i].row;
                C[k].col = A[i].col;
                C[k].value = sum;
                k++;
            }
            i++;
            j++;
        }
    }

    // Add remaining elements of A
    while (i < t1) {
        C[k++] = A[i++];
    }

    // Add remaining elements of B
    while (j < t2) {
        C[k++] = B[j++];
    }

    // Display the result in dense form
    displayDense(C, k, r1, c1);

    return 0;
}

