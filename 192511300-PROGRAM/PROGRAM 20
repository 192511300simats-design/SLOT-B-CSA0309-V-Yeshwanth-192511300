#include <stdio.h>
#include <stdlib.h>

// Function to sort the array in ascending order (using Bubble Sort)
void sortArray(int arr[], int n) {
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

// Iterative Binary Search to find the first day where temperature >= 30
int findFirstGTE30(int arr[], int n) {
    int low = 0, high = n - 1;
    int result = -1;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (arr[mid] >= 30) {
            result = mid; 
            high = mid - 1; 
        } else {
            low = mid + 1;
        }
    }
    return result;
}

// Iterative Binary Search to find the last day where temperature <= 25
int findLastLTE25(int arr[], int n) {
    int low = 0, high = n - 1;
    int result = -1;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (arr[mid] <= 25) {
            result = mid; 
            low = mid + 1; // Look for a later occurrence on the right
        } else {
            high = mid - 1;
        }
    }
    return result;
}

int main() {
    int n;

    // Read n
    if (scanf("%d", &n) != 1) return 0;

    // Validate n <= 50
    if (n <= 0 || n > 50) return 0;

    int arr[n];

    // Read temperatures
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Sort the array
    sortArray(arr, n);

    // Display sorted temperatures
    printf("Sample Output (after sort):\n");
    for (int i = 0; i < n; i++) {
        printf("%d%s", arr[i], (i == n - 1) ? "" : " ");
    }
    printf("\n");

    // Find first >= 30
    int idx1 = findFirstGTE30(arr, n);
    if (idx1 != -1) {
        printf("First >=30: index %d (%d)\n", idx1, arr[idx1]);
    } else {
        printf("First >=30: Not found\n");
    }

    // Find last <= 25
    int idx2 = findLastLTE25(arr, n);
    if (idx2 != -1) {
        printf("Last <=25: index %d (%d)\n", idx2, arr[idx2]);
    } else {
        printf("Last <=25: Not found\n");
    }

    return 0;
}
