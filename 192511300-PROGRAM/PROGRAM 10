#include <stdio.h>

struct Student {
    int roll;
    char name[50];
    float marks;
};

int main() {
    struct Student s[100];
    FILE *fp;
    int n, i;
    int highestIndex = 0;

    float sum = 0.0f;

    printf("Enter number of students: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        return 0;
    }

    fp = fopen("students.txt", "w");
    if (fp == NULL) {
        printf("File could not be opened.\n");
        return 0;
    }

    for (i = 0; i < n; i++) {
        scanf("%d %49s %f", &s[i].roll, s[i].name, &s[i].marks);

        fprintf(fp, "%d %s %.2f\n", s[i].roll, s[i].name, s[i].marks);

        sum += s[i].marks;

        if (s[i].marks > s[highestIndex].marks) {
            highestIndex = i;
        }
    }

    fclose(fp);

    printf("Highest Mark: %.0f (%s)\n", s[highestIndex].marks, s[highestIndex].name);
    printf("Class Average: %.2f\n", sum / n);
    printf("%d records stored successfully.\n", n);

    return 0;
}
