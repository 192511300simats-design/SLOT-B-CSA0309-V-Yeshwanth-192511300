#include <stdio.h>

#define MAX 5

int stack[MAX];
int top = -1;

void push(int value) {
    if (top == MAX - 1)
        printf("Stack Overflow\n");
    else {
        stack[++top] = value;
        printf("%d pushed into stack\n", value);
    }
}

void pop() {
    if (top == -1)
        printf("Stack Underflow\n");
    else
        printf("%d popped from stack\n", stack[top--]);
}

void peek() {
    if (top == -1)
        printf("Stack is empty\n");
    else
        printf("Top element = %d\n", stack[top]);
}

void display() {
    int i;

    printf("Stack: ");
    for (i = top; i >= 0; i--)
        printf("%d ", stack[i]);

    printf("\n");
}

int main() {
    push(10);
    push(20);
    push(30);

    display();

    peek();
    pop();

    display();
    peek();

    return 0;
}

OUTPUT:
10 pushed into stack
20 pushed into stack
30 pushed into stack
Stack: 30 20 10
Top element = 30
30 popped from stack
Stack: 20 10
Top element = 20
