#include <stdio.h>

#define MAX 10
#define INF 99999

int main() {
    int graph[MAX][MAX];
    int selected[MAX] = {0};
    int n, i, j;
    int edges = 0;
    int min, x = 0, y = 0;
    int total = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter weighted adjacency matrix:\n");
    scanf("%d", &graph[0][0]);

    for (i = 0; i < n; i++)
        for (j = 0; j < n; j++) {
            if (i == 0 && j == 0)
                continue;
            scanf("%d", &graph[i][j]);
        }

    selected[0] = 1;

    printf("Edges in Minimum Spanning Tree:\n");

    while (edges < n - 1) {
        min = INF;

        for (i = 0; i < n; i++) {
            if (selected[i]) {
                for (j = 0; j < n; j++) {
                    if (!selected[j] && graph[i][j] != 0 &&
                        graph[i][j] < min) {

                        min = graph[i][j];
                        x = i;
                        y = j;
                    }
                }
            }
        }

        printf("%d - %d : %d\n", x, y, graph[x][y]);

        total += graph[x][y];
        selected[y] = 1;
        edges++;
    }

    printf("Minimum Cost = %d\n", total);

    return 0;
}

