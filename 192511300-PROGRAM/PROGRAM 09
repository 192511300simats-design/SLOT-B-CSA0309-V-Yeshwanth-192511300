int main() {
    int N;
    int a = 0, b = 1, c;
    clock_t start, end;
    double iterativeTime, recursiveTime;
    printf("Enter N: ");
    scanf("%d", &N);
    if (N <= 0) {
        printf("Invalid Input!\n");
        return 0;
    }
    start = clock();
    printf("Iterative: ");
    if (N >= 1) printf("%d ", a);  // 0
    if (N >= 2) printf("%d ", b);  // 1

    for (int i = 3; i <= N; i++) {
        c = a + b;
        printf("%d ", c);
        a = b;
        b = c;
    }
    printf("\n");
    end = clock();
    iterativeTime = ((double)(end - start) * 1000.0) / CLOCKS_PER_SEC; // ms
    calls = 0;
    start = clock();
    printf("Recursive: ");
    for (int i = 0; i < N; i++) {
        printf("%d ", fibonacci(i));
    }
    printf("\n");
    end = clock();
    recursiveTime = ((double)(end - start) * 1000.0) / CLOCKS_PER_SEC; // ms
    printf("Recursive Calls: %d\n", calls);
    printf("Iterative Time: %.3f ms\n", iterativeTime);
    printf("Recursive Time: %.3f ms\n", recursiveTime);
    return 0;
}
