#include <stdio.h>

int main() {
    int n, i, a[100];

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Odd numbers: ");
    for (i = 0; i < n; i++)
        if (a[i] % 2 != 0)
            printf("%d ", a[i]);

    printf("\nEven numbers: ");
    for (i = 0; i < n; i++)
        if (a[i] % 2 == 0)
            printf("%d ", a[i]);

    return 0;
}

OUTPUT:
Enter number of elements: 6
Enter elements:
10 15 22 31 40 47

Odd numbers: 15 31 47
Even numbers: 10 22 40
