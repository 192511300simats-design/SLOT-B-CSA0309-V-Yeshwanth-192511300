int isAnagram(char str1[], char str2[]) {
    int count[26] = {0};
    int i;
    for (i = 0; str1[i] != '\0'; i++) {
        if (isalpha(str1[i])) count[tolower(str1[i]) - 'a']++;
    }
    for (i = 0; str2[i] != '\0'; i++) {
        if (isalpha(str2[i])) count[tolower(str2[i]) - 'a']--;
    }
    for (i = 0; i < 26; i++) {
        if (count[i] != 0) return 0;
    }
    return 1;
}

