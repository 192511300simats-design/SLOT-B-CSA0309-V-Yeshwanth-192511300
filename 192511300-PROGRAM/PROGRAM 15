#include <stdio.h>

#define SIZE 10

int hashTable[SIZE];

void initialize() {
    int i;

    for (i = 0; i < SIZE; i++)
        hashTable[i] = -1;
}

void insert(int key) {
    int index = key % SIZE;
    int start = index;

    while (hashTable[index] != -1) {
        index = (index + 1) % SIZE;

        if (index == start) {
            printf("Hash table full\n");
            return;
        }
    }

    hashTable[index] = key;
}

void display() {
    int i;

    printf("Hash Table:\n");

    for (i = 0; i < SIZE; i++) {
        if (hashTable[i] == -1)
            printf("[%d] -> EMPTY\n", i);
        else
            printf("[%d] -> %d\n", i, hashTable[i]);
    }
}

int main() {
    initialize();

    insert(23);
    insert(43);
    insert(13);
    insert(27);

    display();

    return 0;
}

