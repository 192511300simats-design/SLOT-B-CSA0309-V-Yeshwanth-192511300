#include <stdio.h>

int main() {
    int n;
    
    // Read the number of elements
    if (scanf("%d", &n) != 1) return 0;
    
    // Validate constraint: n <= 50
    if (n <= 0 || n > 50) return 0;
    
    int arr[50];
    
    // Read array elements
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    // Sort array in ascending order (using Bubble Sort)
    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (arr[j] > arr[j + 1]) {
                int temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
    
    // Print sorted array
    printf("Sample Output (after sort): ");
    for (int i = 0; i < n; i++) {
        printf("%d%s", arr[i], (i == n - 1) ? "" : " ");
    }
    printf("\n");

    // Find the first book having >= 300 pages
    int first_idx = -1;
    for (int i = 0; i < n; i++) {
        if (arr[i] >= 300) {
            first_idx = i;
            break;
        }
    }

    // Find the last book having <= 150 pages
    int last_idx = -1;
    for (int i = n - 1; i >= 0; i--) {
        if (arr[i] <= 150) {
            last_idx = i;
            break;
        }
    }

    // Display results for first >= 300
    if (first_idx != -1) {
        printf("First >=300: index %d (%d)\n", first_idx, arr[first_idx]);
    } else {
        printf("First >=300: Not found\n");
    }

    // Display results for last <= 150
    if (last_idx != -1) {
        printf("Last <=150: index %d (%d)\n", last_idx, arr[last_idx]);
    } else {
        printf("Last <=150: Not found\n");
    }

    return 0;
}
